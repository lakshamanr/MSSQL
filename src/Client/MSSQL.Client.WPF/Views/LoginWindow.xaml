<Window x:Class="MSSQL.Client.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="MSSQL Client - Login"
        Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Background="#FAFAFA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="20">
            <StackPanel>
                <TextBlock Text="MSSQL Client"
                          FontSize="24"
                          FontWeight="SemiBold"
                          Foreground="White"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Database Documentation &amp; Management Tool"
                          FontSize="12"
                          Foreground="#E0E0E0"
                          HorizontalAlignment="Center"
                          Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Login Form -->
        <Border Grid.Row="1"
                Background="White"
                Margin="40,30,40,30"
                Padding="30"
                CornerRadius="4"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Sign In"
                          FontSize="20"
                          FontWeight="SemiBold"
                          Foreground="#333333"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,30"/>

                <!-- Username -->
                <TextBlock Text="Username"
                          FontSize="13"
                          FontWeight="Medium"
                          Foreground="#333333"
                          Margin="0,0,0,6"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="14"
                        Padding="10,8"
                        Margin="0,0,0,16"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>

                <!-- Password -->
                <TextBlock Text="Password"
                          FontSize="13"
                          FontWeight="Medium"
                          Foreground="#333333"
                          Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBox"
                            FontSize="14"
                            Padding="10,8"
                            Margin="0,0,0,20"
                            PasswordChanged="PasswordBox_PasswordChanged"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                          FontSize="12"
                          Foreground="#D32F2F"
                          TextWrapping="Wrap"
                          Margin="0,0,0,16"
                          Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisConverter}}"/>

                <!-- Loading Indicator -->
                <StackPanel Orientation="Horizontal"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
                    <ui:ProgressRing IsActive="{Binding IsLoading}" Width="20" Height="20" Margin="0,0,8,0"/>
                    <TextBlock Text="Signing in..."
                              FontSize="12"
                              Foreground="#666666"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Buttons -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                           Content="Cancel"
                           Command="{Binding CancelCommand}"
                           Background="#F3F3F3"
                           Foreground="#333333"
                           BorderThickness="1"
                           BorderBrush="#D0D0D0"
                           Padding="0,10"
                           FontSize="14"
                           Cursor="Hand"/>

                    <Button Grid.Column="2"
                           Content="Sign In"
                           Command="{Binding LoginCommand}"
                           Background="#0078D4"
                           Foreground="White"
                           BorderThickness="0"
                           Padding="0,10"
                           FontSize="14"
                           FontWeight="Medium"
                           Cursor="Hand"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
