<Window x:Class="MSSQL.Client.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:MSSQL.Client.WPF.ViewModels"
        xmlns:views="clr-namespace:MSSQL.Client.WPF.Views"
        xmlns:local="clr-namespace:MSSQL.Client.WPF.Infrastructure"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="MSSQL Client - Database Documentation &amp; Management Tool"
        Height="800" Width="1400"
        WindowState="Maximized">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="MSSQL Client"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Database Documentation &amp; Management"
                               FontSize="12"
                               Foreground="#E0E0E0"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="White"
                        BorderThickness="1"
                        Padding="12,6"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Database Selector -->
        <Border Grid.Row="1" Background="#F8F8F8" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="16,12">
            <views:DatabaseSelectorView DataContext="{Binding DatabaseSelectorViewModel}"/>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <views:LeftMenuView DataContext="{Binding LeftMenuViewModel}"/>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                         Width="5"
                         HorizontalAlignment="Stretch"
                         Background="#E0E0E0"
                         ShowsPreview="True"/>

            <!-- Content Area -->
            <Border Grid.Column="2" Background="#FAFAFA" Padding="16">
                <Grid>
                    <!-- Loading Indicator -->
                    <ui:ProgressRing IsActive="{Binding IsLoading}"
                                    Width="60"
                                    Height="60"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>

                    <!-- Content -->
                    <ContentControl Content="{Binding CurrentContentViewModel}"
                                   Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisConverter}}">
                        <ContentControl.Resources>
                            <!-- Add DataTemplates for different ViewModels here -->
                        </ContentControl.Resources>
                    </ContentControl>

                    <!-- Welcome Message (when no content) -->
                    <StackPanel HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisConverter}}">
                        <TextBlock Text="Welcome to MSSQL Client"
                                  FontSize="24"
                                  FontWeight="SemiBold"
                                  Foreground="#333333"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,8"/>
                        <TextBlock Text="Select a database object from the left menu to view details"
                                  FontSize="14"
                                  Foreground="#666666"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#F0F0F0" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                          Text="{Binding StatusMessage}"
                          VerticalAlignment="Center"
                          FontSize="12"
                          Foreground="#333333"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="API: " FontSize="11" Foreground="#666666" Margin="0,0,4,0"/>
                    <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="0,0,8,0"/>
                    <TextBlock Text="Connected" FontSize="11" Foreground="#666666"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
