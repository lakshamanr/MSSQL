<UserControl x:Class="MSSQL.Client.WPF.Views.DatabaseSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="Database:"
                   FontWeight="SemiBold"
                   Foreground="#333333"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"/>

        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding Databases}"
                  SelectedItem="{Binding SelectedDatabase}"
                  VerticalAlignment="Center"
                  MinWidth="250">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding DatabaseName}" FontWeight="Medium"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <ProgressBar Grid.Column="2"
                    IsIndeterminate="True"
                    Width="100"
                    Height="4"
                    Margin="12,0,0,0"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>

        <StackPanel Grid.Column="3"
                   Orientation="Horizontal"
                   HorizontalAlignment="Right"
                   Visibility="{Binding DatabaseMetaData, Converter={StaticResource BoolToVisConverter}}">
            <TextBlock Text="Server: " FontSize="11" Foreground="#666666" Margin="0,0,4,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding DatabaseMetaData.DatabaseInfo.DatabaseName}"
                      FontSize="11"
                      FontWeight="Medium"
                      Foreground="#333333"
                      VerticalAlignment="Center"
                      Margin="0,0,16,0"/>

            <TextBlock Text="Size: " FontSize="11" Foreground="#666666" Margin="0,0,4,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding DatabaseMetaData.DatabaseInfo.SizeMB, StringFormat='{}{0:N2} MB'}"
                      FontSize="11"
                      FontWeight="Medium"
                      Foreground="#333333"
                      VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
